# Local docker-compose Postgres (default). For the deployed box, point both URLs
# at the Aurora Serverless (Postgres) writer endpoint with sslmode=require — e.g.
#   postgresql://USER:PASS@<cluster>.cluster-xxxx.<region>.rds.amazonaws.com:5432/tournament?schema=public&sslmode=require
# Aurora has no Neon-style pooled/direct split, so DATABASE_URL and DIRECT_URL are
# the same endpoint (Prisma's own pool handles connections from the single box).
DATABASE_URL="postgresql://tournament:tournament@localhost:5432/tournament?schema=public"
DIRECT_URL="postgresql://tournament:tournament@localhost:5432/tournament?schema=public"

# Reserved for Part 1 (auth) so env validation is stable across parts.
JWT_SECRET="dev-secret-change-me"
BOOTSTRAP_ADMIN_CODE="dev-bootstrap-code"

PORT=4000

# Set to "true" for local/testing to seed demo players (player3..player10,
# password "password"). Leave unset/false in prod so the seed skips them.
SEED_DEMO_USERS=true
